{
  "name": "relief-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "离线标志浮雕分层演示工具",
  "author": "Relief Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:engine": "node scripts/python.cjs -m unittest discover -s engine/tests -v",
    "build:engine": "node scripts/python.cjs -m PyInstaller --noconfirm --clean --onedir --name relief-engine --distpath engine-dist --workpath build/engine engine/main.py",
    "pack": "npm run build && npm run build:engine && node scripts/collect_licenses.cjs && electron-builder --win dir",
    "dist:win": "npm run build && npm run build:engine && node scripts/collect_licenses.cjs && electron-builder --win nsis",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.reliefstudio.demo",
    "productName": "Relief Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine-dist/relief-engine",
        "to": "engine"
      },
      {
        "from": "samples",
        "to": "samples"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
